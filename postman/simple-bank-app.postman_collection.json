                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('New customer is in the list', () => {",
                  "  const ids = pm.response.json().map(u => u.userId);",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('userId')));",
